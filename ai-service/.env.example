# ai-service/.env.example
# OWNER: Claude Code. Salin jadi ai-service/.env, isi nilai asli, JANGAN commit .env.

ENV=development

# --- Validasi caller internal (dipanggil server Node, tidak boleh publik) ---
AI_SERVICE_INTERNAL_KEY=

# --- Gemini API (ARCHITECTURE.md §6) ---
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15

# --- OCR ---
# pytesseract lokal untuk v1.0 (PRD.md §9) — tidak butuh API key.
# Kalau tesseract binary tidak ada di PATH sistem, set path-nya di sini:
TESSERACT_CMD=
