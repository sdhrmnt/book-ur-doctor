# server/.env.example
# OWNER: Claude Code. Salin jadi server/.env, isi nilai asli, JANGAN commit .env.
# Kalau menambah variabel baru, tambahkan juga di sini (AGENTS.md §7).

NODE_ENV=development
PORT=4000

# --- Database (Postgres 15, Sequelize) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Database khusus test. Sengaja DIPISAH dari DB_NAME supaya `npm test`
# (yang menjalankan TRUNCATE CASCADE di setup.js) tidak pernah mengenai
# database development.
DB_NAME_TEST=ur-doc-test

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Object storage: ImageKit ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
SIGNED_URL_TTL_SECONDS=300

# --- ai-service (internal call, tidak boleh terekspos publik) ---
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=

# --- Aturan bisnis (lihat SPEC.md §4, §6, §7, PRD.md §9) ---
SLOT_DURATION_MINUTES=30
MIN_BOOKING_LEAD_MINUTES=60
MIN_CANCEL_LEAD_HOURS=6
MAX_UPLOAD_BYTES=15728640
REMINDER_OFFSETS_HOURS=48,24

# --- Retensi dokumen setelah akun pasien dinonaktifkan (PRD.md §9) ---
DOCUMENT_RETENTION_DAYS_AFTER_DEACTIVATION=90
